{
  "schemaVersion": 1,
  "scope": "Design requirements only; no clips, rigs or runtime included",
  "timeScaleRealToGame": 5,
  "profiles": [
    {
      "id": "humanoid",
      "nameVi": "Người đi bộ",
      "states": [
        "idle",
        "walk",
        "run",
        "wait",
        "cross",
        "board",
        "alight",
        "sit",
        "work"
      ],
      "pivots": [
        "root",
        "hips",
        "spine",
        "head",
        "upperArm.L/R",
        "forearm.L/R",
        "hand.L/R",
        "thigh.L/R",
        "shin.L/R",
        "foot.L/R"
      ],
      "note": "Gait phù hợp tốc độ và chiều cao; bàn chân không trượt khi dừng.",
      "implemented": false
    },
    {
      "id": "wheelchair",
