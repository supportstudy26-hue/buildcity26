# Supabase Settings > API. Only browser-safe publishable/anon keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server variables: enter only in Vercel environment settings (no VITE_ prefix).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# SUPABASE_SECRET_KEY=SET_DIRECTLY_IN_VERCEL_NEVER_COMMIT
# ACCOUNT_ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
